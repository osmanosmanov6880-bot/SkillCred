{
  "uid": "skillcred-core",
  "title": "SkillCred API health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "title": "HTTP requests per second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (route,status) (rate(skillcred_http_requests_total[5m]))", "refId": "A"}]},
    {"id": 2, "title": "p95 request duration", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le,route) (rate(skillcred_http_request_duration_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 3, "title": "Credential operations by outcome", "type": "timeseries", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "targets": [{"expr": "sum by (operation,outcome) (rate(skillcred_operations_total[5m]))", "refId": "A"}]}
  ]
}
