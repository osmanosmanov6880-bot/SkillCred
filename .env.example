# Example only. Do not commit real values or copy these values to production.
SKILLCRED_DATA_DIR=./skillcred-data
SKILLCRED_ISSUER_NAME=Example Skills Lab
SKILLCRED_STATUS_LIST_URL=https://credentials.example.org/status-list
SKILLCRED_LANG=en
SKILLCRED_RATE_LIMIT=60
SKILLCRED_RATE_WINDOW_SECONDS=60
# Inject through a secret manager. The value must be a high-entropy passphrase.
# SKILLCRED_KEY_PASSPHRASE=
# Or use a protected file readable only by the service user.
# SKILLCRED_KEY_PASSPHRASE_FILE=/run/secrets/skillcred-passphrase
# Preferred: distinct tokens for each role in a JSON object.
# SKILLCRED_API_TOKENS={"issuer":"...","revoker":"...","verifier":"...","admin":"..."}
# Or SKILLCRED_API_TOKENS_FILE=/run/secrets/skillcred-api-tokens.json
# Legacy migration only: SKILLCRED_API_TOKEN maps to admin. Prefer a protected token file.
# SKILLCRED_API_TOKEN_FILE=/run/secrets/skillcred-bootstrap-admin

# Optional shared distributed rate limiter (install with pip install -e '.[redis]').
# Keep Redis reachable only from trusted application instances.
# SKILLCRED_REDIS_URL=redis://redis:6379/0
# Route caps, matched against method and route; omit to use defaults.
# SKILLCRED_RATE_LIMITS_JSON={"POST /issue":12,"POST /revoke":12,"POST /verify":90}
# Per-role cap ceilings (JWT roles are cryptographically verified before applying a role cap).
# SKILLCRED_ROLE_RATE_LIMITS_JSON={"issuer":12,"revoker":12,"verifier":90,"admin":60}
# Optional independent passphrase for encrypted clients.enc; otherwise key passphrase is reused.
# SKILLCRED_CLIENT_STORE_PASSPHRASE_FILE=/run/secrets/skillcred-client-store-passphrase
# Set true only after a governed admin-grant review.
# SKILLCRED_ALLOW_CLIENT_ADMIN=false
# API documentation is disabled by default for production deployments.
# SKILLCRED_ENABLE_API_DOCS=false
