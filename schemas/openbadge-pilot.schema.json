{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcred.example/schemas/openbadge-pilot.schema.json",
  "title": "SkillCred Open Badges 3.0 pilot-profile shape (not an official 1EdTech schema)",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "array",
      "contains": {
        "const": "OpenBadgeCredential"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:key:"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "type",
        "achievement"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "array",
          "contains": {
            "const": "AchievementSubject"
          }
        },
        "achievement": {
          "type": "object",
          "required": [
            "id",
            "type",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "array",
              "contains": {
                "const": "Achievement"
              }
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "identifier"
          ]
        }
      ]
    },
    "credentialStatus": {
      "type": "object"
    },
    "proof": {
      "type": "object",
      "required": [
        "type",
        "cryptosuite",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:key:"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
